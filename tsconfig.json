{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    // Sources run straight on Node 24's native type stripping, so relative
    // imports carry the real `.ts` extension; `npm run build` rewrites them.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "test-integration"]
}
