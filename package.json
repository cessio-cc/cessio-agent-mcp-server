{
  "name": "@cessio/agent-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Local self-custody MCP server: an AI agent trades the Cessio RFQ desk as maker and taker.",
  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "canton", "rfq", "cessio", "trading", "ai-agent"],
  "homepage": "https://docs.devnet.cessio.cc/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cessio-cc/cessio-agent-mcp-server.git"
  },
  "engines": { "node": ">=24" },
  "bin": { "agent-mcp-server": "dist/index.js" },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "ws": "^8.21.2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
